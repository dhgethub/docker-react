# Copy to .env and fill in. Never commit .env.

# --- Axonius ---
AXONIUS_URL=https://yourcompany.axonius.com
AXONIUS_API_KEY=
AXONIUS_API_SECRET=
# Optional: limit to a saved query instead of all devices
AXONIUS_SAVED_QUERY=
AXONIUS_VERIFY_SSL=true

# --- Sophos Central (Settings > API Credentials Management, "Service Principal Read-Only") ---
SOPHOS_CLIENT_ID=
SOPHOS_CLIENT_SECRET=

# --- Cisco Meraki (Organization > API & webhooks) ---
MERAKI_API_KEY=
# Optional: comma-separated org IDs to restrict to
MERAKI_ORG_IDS=

# --- Lucid (optional, only for --lucid-upload) ---
# OAuth2 access token or API key with DocumentCreate scope
LUCID_API_TOKEN=
